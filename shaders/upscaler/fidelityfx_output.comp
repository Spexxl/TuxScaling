#version 450

layout(set = 0, binding = 0) uniform sampler2D fsr_output;
layout(set = 0, binding = 1) writeonly uniform image2D output_image;

layout(push_constant) uniform Params {
    uint output_width;
    uint output_height;
    vec2 viewport_offset;
    vec2 viewport_size;
    uint encode_srgb;
} params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

vec3 linear_to_srgb(vec3 color) {
    vec3 linear_segment = color * 12.92;
    vec3 power_segment = 1.055 * pow(max(color, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return mix(power_segment, linear_segment, lessThanEqual(color, vec3(0.0031308)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(params.output_width) || pixel.y >= int(params.output_height)) {
        return;
    }

    vec2 output_size = vec2(params.output_width, params.output_height);
    vec2 center = vec2(pixel) + vec2(0.5);
    vec2 viewport_min = params.viewport_offset * output_size;
    vec2 viewport_extent = params.viewport_size * output_size;
    vec2 local = (center - viewport_min) / viewport_extent;
    if (any(lessThan(local, vec2(0.0))) || any(greaterThanEqual(local, vec2(1.0)))) {
        imageStore(output_image, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec4 color = texture(fsr_output, local);
    if (params.encode_srgb != 0u) {
        color.rgb = linear_to_srgb(color.rgb);
    }
    imageStore(output_image, pixel, color);
}
