#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D input_frame;
layout(binding = 1) uniform sampler2D history_frame;
layout(rg16f, binding = 2) uniform readonly image2D motion_image;
layout(r8, binding = 3) uniform readonly image2D confidence_image;
layout(r8, binding = 4) uniform readonly image2D reactive_image;
layout(r8, binding = 5) uniform readonly image2D disocclusion_image;
layout(r32f, binding = 6) uniform readonly image2D exposure_image;
layout(r32f, binding = 7) uniform readonly image2D depth_image;
layout(r8, binding = 8) uniform readonly image2D composition_image;
layout(binding = 9) uniform writeonly image2D output_image;

layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint input_width;
    uint input_height;
    uint motion_width;
    uint motion_height;
    uint valid;
    uint reset;
    uint debug_view;
    uint depth_semantics;
    float current_jitter_x;
    float current_jitter_y;
    float previous_jitter_x;
    float previous_jitter_y;
    float pre_exposure;
    float frame_delta;
} p;

vec3 neighborhood_min(vec2 uv) {
    vec3 result = vec3(1.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            result = min(result, texture(input_frame, uv + vec2(x, y) / vec2(p.input_width, p.input_height)).rgb);
        }
    }
    return result;
}

vec3 neighborhood_max(vec2 uv) {
    vec3 result = vec3(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            result = max(result, texture(input_frame, uv + vec2(x, y) / vec2(p.input_width, p.input_height)).rgb);
        }
    }
    return result;
}

float depth_discontinuity(ivec2 pixel) {
    ivec2 size = imageSize(depth_image);
    ivec2 center_pixel = clamp(pixel, ivec2(0), size - 1);
    float center = imageLoad(depth_image, center_pixel).r;
    if (isnan(center) || isinf(center)) return 1.0;
    float gradient = 0.0;
    // A two-pixel support band catches the complete narrow disocclusion
    // boundary before history can leak across a depth step.
    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            ivec2 neighbour = clamp(center_pixel + ivec2(x, y), ivec2(0), size - 1);
            float value = imageLoad(depth_image, neighbour).r;
            if (isnan(value) || isinf(value)) return 1.0;
            gradient = max(gradient, abs(value - center));
        }
    }
    return clamp(gradient * 4.0, 0.0, 1.0);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(p.width) || pixel.y >= int(p.height)) {
        return;
    }
    vec2 output_uv = (vec2(pixel) + 0.5) / vec2(p.width, p.height);
    float input_aspect = float(p.input_width) / float(p.input_height);
    float output_aspect = float(p.width) / float(p.height);
    vec2 content_size = output_aspect > input_aspect
        ? vec2(input_aspect / output_aspect, 1.0)
        : vec2(1.0, output_aspect / input_aspect);
    vec2 content_min = (vec2(1.0) - content_size) * 0.5;
    vec2 content_max = content_min + content_size;
    if (any(lessThan(output_uv, content_min)) || any(greaterThan(output_uv, content_max))) {
        imageStore(output_image, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    vec2 input_uv = (output_uv - content_min) / content_size;
    ivec2 input_pixel = min(
        ivec2(input_uv * vec2(p.input_width, p.input_height)),
        ivec2(p.input_width, p.input_height) - 1
    );
    vec4 current = texture(input_frame, input_uv);
    if (p.debug_view != 0) {
        float value = 0.0;
        if (p.debug_view == 1) {
            value = imageLoad(reactive_image, input_pixel).r;
        } else if (p.debug_view == 2) {
            value = imageLoad(disocclusion_image, input_pixel).r;
        } else if (p.debug_view == 3) {
            value = imageLoad(depth_image, input_pixel).r;
        } else if (p.debug_view == 4) {
            value = imageLoad(composition_image, input_pixel).r;
        } else if (p.debug_view == 5) {
            value = imageLoad(exposure_image, ivec2(0)).r;
        }
        imageStore(output_image, pixel, vec4(value, value, value, 1.0));
        return;
    }
    ivec2 motion_pixel = min(input_pixel, ivec2(p.motion_width, p.motion_height) - 1);
    vec2 motion = imageLoad(motion_image, motion_pixel).xy;
    vec2 history_uv = clamp(
        output_uv
            + (motion + vec2(p.previous_jitter_x, p.previous_jitter_y)
                - vec2(p.current_jitter_x, p.current_jitter_y))
                / vec2(p.input_width, p.input_height) * content_size,
        content_min,
        content_max
    );
    vec3 history = texture(history_frame, history_uv).rgb;
    vec3 lower = neighborhood_min(input_uv);
    vec3 upper = neighborhood_max(input_uv);
    history = clamp(history, lower, upper);

    float confidence = imageLoad(confidence_image, motion_pixel).r;
    float reactive = imageLoad(reactive_image, input_pixel).r;
    float disocclusion = imageLoad(disocclusion_image, input_pixel).r;
    float exposure = max(imageLoad(exposure_image, ivec2(0)).r, 0.001);
    float depth_edge = p.depth_semantics != 0 ? depth_discontinuity(input_pixel) : 0.0;
    float depth_rejection = smoothstep(0.03, 0.20, depth_edge);
    float frame_delta_scale = clamp(0.016667 / max(p.frame_delta, 0.00025), 0.25, 1.0);
    float history_weight = (p.valid != 0 && p.reset == 0)
        ? clamp(0.08 + confidence * 0.82, 0.08, 0.9)
            * (1.0 - reactive) * (1.0 - disocclusion) * (1.0 - depth_rejection)
            * frame_delta_scale
        : 0.0;
    vec3 resolved = mix(current.rgb * exposure * max(p.pre_exposure, 0.001), history, history_weight);
    imageStore(output_image, pixel, vec4(max(resolved, vec3(0.0)), current.a));
}
