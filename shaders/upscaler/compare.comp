#version 450

layout(set = 0, binding = 0) uniform sampler2D off_image;
layout(set = 0, binding = 1) uniform sampler2D active_image;
layout(set = 0, binding = 2) writeonly uniform image2D output_image;

layout(push_constant) uniform Params {
    uint output_width;
    uint output_height;
    uint input_width;
    uint input_height;
    float split;
} params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(params.output_width) || pixel.y >= int(params.output_height)) {
        return;
    }

    vec2 output_size = vec2(params.output_width, params.output_height);
    vec2 input_size = vec2(params.input_width, params.input_height);
    vec2 output_uv = (vec2(pixel) + vec2(0.5)) / output_size;
    float input_aspect = input_size.x / input_size.y;
    float output_aspect = output_size.x / output_size.y;
    vec2 content_size = output_aspect > input_aspect
        ? vec2(input_aspect / output_aspect, 1.0)
        : vec2(1.0, output_aspect / input_aspect);
    vec2 content_min = (vec2(1.0) - content_size) * 0.5;
    vec2 content_max = content_min + content_size;
    bool in_content = all(greaterThanEqual(output_uv, content_min))
        && all(lessThan(output_uv, content_max));

    vec4 off = vec4(0.0, 0.0, 0.0, 1.0);
    if (in_content) {
        vec2 input_uv = (output_uv - content_min) / content_size;
        off = texture(off_image, input_uv);
    }
    vec4 active_color = in_content ? texture(active_image, output_uv) : off;
    imageStore(output_image, pixel, pixel.x < int(clamp(params.split, 0.0, 1.0) * params.output_width)
        ? off
        : active_color);
}
