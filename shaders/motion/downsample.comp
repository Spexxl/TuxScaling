#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
void main() {
    uvec2 q=gl_GlobalInvocationID.xy;
    if(q.x>=p.width || q.y>=p.height) return;
    uvec2 parent_size=uvec2(p.parent_width,p.parent_height);
    uvec2 base=min(q*2u,parent_size-1u);
    uvec2 right=min(base+uvec2(1,0),parent_size-1u);
    uvec2 bottom=min(base+uvec2(0,1),parent_size-1u);
    uvec2 bottom_right=min(base+uvec2(1,1),parent_size-1u);
    uint row0=p.parent_offset+base.y*p.parent_width;
    uint row1=p.parent_offset+bottom.y*p.parent_width;
    float sum=current_luma[row0+base.x]+current_luma[row0+right.x]+
        current_luma[row1+bottom.x]+current_luma[row1+bottom_right.x];
    current_luma[p.offset+q.y*p.width+q.x]=sum*0.25;
}
